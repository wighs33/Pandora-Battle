# Unreal Engine generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Content policy for showcase repository
# Ignore all content by default, then allow gameplay logic assets only.
Content/**
!Content/**/
!Content/**/BP_*.uasset
!Content/**/ABP_*.uasset
!Content/**/ALI_*.uasset
!Content/**/AM_*.uasset
!Content/**/WBP_*.uasset
!Content/**/DA_*.uasset
!Content/**/GA_*.uasset
!Content/**/GE_*.uasset
!Content/**/GCN_*.uasset
!Content/**/IA_*.uasset
!Content/**/IMC_*.uasset

# Training bot navigation requires this map's RecastNavMesh load settings.
!Content/Map/LV_TrainingRoom.umap

# Project status cue Blueprints use the existing GC_ names.
!Content/GAS/Cue/GC_Burning.uasset
!Content/GAS/Cue/GC_Frozen.uasset
!Content/GAS/Cue/GC_Shocked.uasset

# Skill fire presentation has project-skeleton sampling configuration.
!Content/Niagara/NS_Fire.uasset

# Project-owned title-screen artwork and editable vector sources.
!Content/UI/Asset/TitleStyle/*.uasset
!Content/UI/Asset/TitleStyle/SourceArt/*.png
!Content/UI/Asset/TitleStyle/SourceArt/*.svg
!Content/UI/Asset/TitleStyle/SourceArt/background-prompt.txt

# Project-owned lobby UI artwork and editable vector sources.
!Content/UI/Asset/LobbyStyle/*.uasset
!Content/UI/Asset/LobbyStyle/SourceArt/*.png
!Content/UI/Asset/LobbyStyle/SourceArt/*.svg

# Project-owned profile panel artwork and its editable source.
!Content/UI/Asset/LeftProfileStyle/*.uasset
!Content/UI/Asset/LeftProfileStyle/SourceArt/*.png
!Content/UI/Asset/LeftProfileStyle/SourceArt/*-prompt.txt

# Project-owned Player Vitals HUD artwork.
!Content/UI/Asset/VitalsSigil/*.uasset

# Shared menu translations and their editable import source.
!Content/UI/Localization/*.uasset
!Content/UI/Localization/Source/*.csv

# Runtime UI rendering material used by the paint-canvas feature.
!Content/Materials/M_UI_PaintCanvasOpaque.uasset
!Content/Materials/M_SpeechBubble.uasset
!Content/Materials/M_Brush.uasset

# Functional portal capture assets referenced by DA_Portal.
!Content/Env/Portal/SM_PortalDisc.uasset
!Content/Env/M_Portal.uasset
!Content/effect/NS_Portal.uasset
!Content/effect/Hue.uasset
!Content/effect/m_Radial.uasset
!Content/effect/m_smoke2.uasset
!Content/effect/T_Smoke01_SubUV_9x9.uasset

# Ignore backup copies of assets
Content/**/*.pre_restore_*.uasset
Content/**/*.before_recover_*.uasset

# Ignore marketplace / art-heavy packs even if they contain blueprint assets
Content/IgniteStarterPack/**
Content/SwordAndShield/**
Content/MuzzleFlash/Demo/**
Content/AdvancedVillagePack/**
Content/Asian_Village/**
Content/Environment/**
Content/Fantastic_Dungeon_Pack/**
Content/RamsterZ_FreeAnims_Volume1/**
Content/Reference/**
Content/StylizedProvencal/**
Content/VFX/Environment/**

# Decorative actor built only from StylizedProvencal meshes
Content/Env/BP_Windmill.uasset

# Third-party server SDK plugin installed locally from the Amazon GameLift release (see Docs/GameLift_Backend.md)
/Plugins/GameLiftServerSDK/

# IDE and local tooling
.idea/
.vs/
.codex/
.claude/settings.local.json

# Local code study documents

# Rider / Visual Studio user files
*.sln
*.slnx
*.sln.DotSettings.user
*.vcxproj.user
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.user
.vsconfig

# Logs and temporary files
*.log
*.tmp
__pycache__/

# Local tool output, scratch data and portfolio material (not project code)
/.codex_tmp/
/tmp/
/output/
/Exports/
/Portfolio/
/SourceArt/
/LabProject.png

# OS junk
Thumbs.db
Desktop.ini
