!Content/effect/Hue.uasset
!Content/effect/m_Radial.uasset
!Content/effect/m_smoke2.uasset
!Content/effect/T_Smoke01_SubUV_9x9.uasset

# Ignore backup copies of assets
Content/**/*.pre_restore_*.uasset
Content/**/*.before_recover_*.uasset

# Ignore art-heavy subfolders inside otherwise allowed project roots.
Content/VFX/Environment/**

# Map dressing assets are maintained outside the gameplay showcase history.
Content/Env/BP_Windmill.uasset

