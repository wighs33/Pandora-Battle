#: /Game/Pandora/Data/DA_Pandora_Chain.DA_Pandora_Chain.Description
msgctxt ",382D6F6749A7031C84F31688F47B905F"
msgid "A Pandora marked by the memory of the seal that once bound Hethos beneath the earth."
msgstr "Пандора с памятью о печати, некогда сковавшей Хетоса под землёй."

#. Key:	062659474B906B203C8C18BA8F4B8D90
